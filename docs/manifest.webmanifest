{
  "name": "CookThis",
  "short_name": "CookThis",
  "description": "A fast, lazy-cook-friendly meal planner tuned to your blood work.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0C0C0D",
  "theme_color": "#0C0C0D",
  "lang": "en",
  "categories": ["food", "health", "lifestyle"],
  "icons": [
    { "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "./icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "./icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Today", "url": "./#/today", "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Shopping list", "url": "./#/shop", "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
